                    "medicalRecordNumber": "string",
                    "memberPhone": "string"
                  }
                }
              }
            }
          },
          "400": {
            "description": "ERR1000 - corporateProviderTaxIdNumber is required || ERR1000 - careProviderFirstName is required || ERR1000 - careProviderLastNameOrOrganizationName is required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorVO"
                },
                "example": {
                  "errorMessageList": [{
                    "code": "string",
