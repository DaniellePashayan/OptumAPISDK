    "/v1/apim/provider/lookup": {
      "post": {
        "tags": ["Case Search"],
        "summary": "Case Provider Lookup",
        "description": "The provider search service can be utilized to confirm Care Provider names to ensure that the provider name entered in the caseSummary or caseDetail request matches the United Health Group name.\n<br></br>\nAll care provider records tied to the entered Corporate Provider Tax ID Number will be returned in the response. If there are more than 50 records the request can be updated to view additional page results. \n<br></br>\n<strong>Request attributes:</strong>\n<br><br>\nTo return the care providers associated to the Corporate Tax ID Number the following attribute is required: <strong>corporateProviderTaxIdNumber </strong>\n<br><br>\nAdditional details about the request/response attributes can be found in the data dictionary.\n<br><br>\nAllowed payerIds are 87726, 25463, 37602, 65088, 76342, 78857, 81400, 86047, 86050, 95123, 95378, 95467, 96385, 06111, 03432",
        "operationId": "GET-REFERRAL-PROVIDER",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReferralProviderRequestAPIM"
              },
              "example": {
                "corporateProviderTaxIdNumber": "string",
                "page": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReferralProviderResponseAPIM"
                },
                "example": {
                  "pagingState": [
                    {
                      "page": "page",
                      "totalPages": "totalPages",
                      "totalRecords": "totalRecords"
                    }
                  ],
                  "careProviderList": [
                    {
                      "careProviderName": "careProviderName",
                      "careProviderNPI": "careProviderNPI",
                      "careProviderLastName": "careProviderLastName",
                      "careProviderFirstName": "careProviderFirstName"
                    }
                  ],
                  "errors": [
                    {
                      "code": "code",
                      "message": "message"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad Request || ERR1000 - corporateProviderTaxIdNumber is required || ERR1000 - page must be a valid number and should be greater than zero.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                },
                "example": {
                  "code": "string",
                  "message": "string"
                }
              }
            }
          },
          "404": {
            "description": "ERR0010 - No record found || ERR0032 - Client ID not found. || ERR0033 - Corporate Provider Tax ID Number not found for this Client ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                },
                "example": {
                  "code": "string",
                  "message": "string"
                }
              }
            }
          }
        }
      }
    }
  },
