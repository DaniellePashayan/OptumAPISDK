  "paths": {
    "/v1/apim/case/summary": {
      "post": {
        "tags": ["Case Search"],
        "summary": "Summary By Provider And Member",
        "description": "The case summary service will return all existing cases for the Corporate Tax ID and Care Provider included on the request along with high level details including Service Reference Numbers (SRN), Case Status and other case details.\n<br></br>\n<strong>Request attributes:</strong>\n<br><br>\nTo return the case summary list the following attributes are required: \n<br> <strong>corporateProviderTaxIdNumber </strong> along with <strong> careProviderFirstName </strong> AND <strong> careProviderLastNameOrOrganizationName </strong>\n<br><br>\nIf searching by an organization/facility <strong>careProviderFirstName</strong> should be “Null”.<br><br>To filter the results by a specific patient the following attribute combinations can be included in the request:\n\n<ul style=\"list-style-type: disc;padding-left: 20px;\">\n  <li style=\"font-weight:400\"> <strong>  memberId </strong>  AND <strong> memberBirthDate </li></strong>\n  <li style=\"font-weight:400\"> <strong> memberId, memberFirstName</strong>  AND <strong> memberLastName </strong> </li>\n  <li style=\"font-weight:400\"> <strong> MemberFirstName, memberLastName, memberBirthDate</strong>  AND <strong> memberStateCode </strong> \n  </li>\n</ul>\n<br>\nAdditional optional attributes can be utilized to filter the results by: \n<ul style=\"list-style-type: disc;padding-left: 20px;\">\n  <li style=\"font-weight:400\"><strong> serviceSetting </strong> </li>\n  <li style=\"font-weight:400\"><strong>status </li></strong>\n  <li style=\"font-weight:400\"><strong>startDate </li> </strong>\n  <li style=\"font-weight:400\"><strong>endDate</strong></li>\n</ul>\n<br>\nAdditional details about the request/response attributes can be found in the data dictionary.\n<br><br>\n<strong>Note:</strong> If there more than 200 cases in response, the API will return a message to refine the search criteria for shorter time periods.\n<br><br>\nAllowed payerIds are 87726, 25463, 37602, 65088, 76342, 78857, 81400, 86047, 86050, 95123, 95378, 95467, 96385, 06111, 03432\n<br><br>\nThis summary response does not include case status for Cardiology, Gastroenterology endoscopy, Oncology, Physical health, Radiology, Radiation Oncology, or Specialty Pharmacy prior authorization/notification request.",
        "operationId": "GET-CASE-SUMMARY-BY-PROVIDER-AND-MEMBER",
        "parameters": [{
          "name": "Authorization",
          "in": "header",
          "required": true,
          "schema": {
            "type": "string"
          }
        }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaseSummaryRequestAPIM"
              },
              "example": {
                "corporateProviderTaxIdNumber": "string",
                "careProviderFirstName": "string",
                "careProviderLastNameOrOrganizationName": "string",
                "careProviderAddressLine1": "string",
                "careProviderStateCode": "string",
                "careProviderZipCode": "string",
                "memberId": "string",
                "memberFirstName": "string",
                "memberLastName": "string",
                "memberBirthDate": "string",
                "memberStateCode": "string",
                "memberZipCode": "string",
                "groupOrPolicyNumber": "string",
                "serviceSetting": "string",
                "status": "string",
                "startDate": "string",
                "endDate": "string"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success || ERR0010 - No Records found || ERR008 - Request Data is missing (birthDate) || ERR0036 - careproviderFirstName/careproviderLastNameOrOrganizationName is invalid, please provide a valid input. To validate Care Provider name please utilize the provider lookup",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseSummaryResponseAPIM"
                },
                "example": {
                  "caseSummary": [
                    {
                      "serviceReferenceNumber": "AXXXXXXXXX",
                      "memberID": "memberID",
                      "memberFirstName": "memberFirstName",
                      "memberLastName": "memberLastName",
                      "serviceSetting": "serviceSetting",
                      "placeOfService": "placeOfService",
                      "serviceDates": "01/01/0000-01/01/0000",
                      "caseStatus": "caseStatus",
                      "overallCoverageStatus": "overallCoverageStatus"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "ERR1000 - careProviderFirstName is required || ERR1000 - careProviderLastName is required || ERR1000 - corporateProviderTaxIdNumber is required || ERR1000 - either memberId or memberFirstName/memberLastName/memberStateCode is required || ERR1000 - memberBirthDate or memberFirstName/memberLastName is required || ERR1000 - memberBirthDate/memberStateCode or memberId is required || PAANI3001 - The case search results in excessive number of cases returned. Please refine the search criteria or date range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorVO"
                },
                "example": {
                  "errorMessageList": [{
                    "code": "string",
                    "message": "string"
                  }],
                  "code": "string",
                  "message": "string"
                }
              }
            }
          },
          "404": {
            "description": "ERR0032 - Client ID not found || ERR0033 - Corporate Provider Tax ID Number not found for this Client ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorVO"
                },
                "example": {
                  "errorMessageList": [{
                    "code": "string",
                    "message": "string"
                  }],
                  "code": "string",
                  "message": "string"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error || ERR0034 - Service setting is invalid. Please update your request with one of the following - Inpatient, Outpatient Facility, Outpatient, or All and resubmit your request || ERR0035 - Status is invalid. Please update your request with one of the following - Cancelled, Open, Closed or All and resubmit your request || ERR0036 - careProviderTaxIdNumber, careproviderFirstName, careProviderLastNameOrOrginzationName is invalid, please provide a valid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorVO"
                },
                "example": {
                  "errorMessageList": [{
                    "code": "string",
                    "message": "string"
                  }],
                  "code": "string",
                  "message": "string"
                }
              }
            }
          }
        }
      }
    },
    "/v1/apim/case/detail": {
      "post": {
        "tags": ["Case Search"],
        "summary": "Case Detail By Provider",
        "description": "The Case Details service provides the ability to search for a case by Service Reference Number (SRN) and returns the matching Prior Authorization case details.\n<br><br>\nA record will be returned if the care provider entered on the request is listed on the case as: submitting/requesting, ordering, admitting/attending, or servicing provider.\n<br><br>\n<strong>Request attributes:</strong> \n<br><br>\nTo return the case details the following attributes are required: \n<strong>serviceReferenceNumber</strong>, <strong>corporateProviderTaxIdNumber</strong> along with <strong>careProviderFirstName </strong> AND <strong>careProviderLastNameOrOrganizationName</strong>\n<br><br>\nIf searching by an organization/facility careProviderFirstName should be “Null”. Additional details about the request/response attributes can be found in the data dictionary.\n<br><br>\nAllowed payerIds are 87726, 25463, 37602, 65088, 76342, 78857, 81400, 86047, 86050, 95123, 95378, 95467, 96385, 06111, 03432\n<br><br>\nThis detail response does not include Cardiology, Gastroenterology endoscopy, Oncology, Physical health, Radiology, Radiation Oncology, or Specialty Pharmacy prior authorization/notification request details.\n",
        "operationId": "GET-CASE-DETAIL-BY-PROVIDER",
        "parameters": [{
          "name": "Authorization",
          "in": "header",
          "required": true,
          "schema": {
            "type": "string"
          }
        }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaseDetailRequestAPIM"
              },
              "example": {
                "serviceReferenceNumber": "string",
                "corporateProviderTaxIdNumber": "string",
                "careProviderFirstName": "string",
                "careProviderLastNameOrOrganizationName": "string"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success || ERR0010 - No record found || ERRXXXX - Message will depend on the membership and will display when this case can not be viewed through the API Marketplace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseDetailResponseAPIM"
                },
                "example": {
                  "caseSearchMessages": [
                    "string"
                  ],
                  "caseDetail": {
                    "serviceReferenceNumber": "string",
                    "caseStatus": "string",
                    "caseStatusReason": "string",
                    "primaryCarePhysician": "string",
                    "advanceNotifyDateTime": "string",
                    "admissionNotifyDateTime": "string",
                    "expectedServiceStartDate": "string",
                    "expectedServiceEndDate": "string",
                    "actualServiceStartDate": "string",
                    "actualServiceEndDate": "string"
                  },
                  "coverageStatus": [
                    {
                      "overallCoverageStatus": "string",
                      "procedureCode": "string",
                      "description": "string",
                      "coverageStatus": "string",
                      "decisionDate": "string",
                      "geneticMolecularTestCode": "string",
                      "geneticMolecularTestReviewType": "string"
                    }
                  ],
                  "clinicalNotes": [
                    {
                      "createdTime": "string",
                      "createdBy": "string",
                      "noteText": "string"
                    }
                  ],
                  "patientDetails": {
                    "memberId": "string",
                    "firstName": "string",
                    "lastName": "string",
                    "groupNumber": "string",
                    "product": "string",
                    "relationship": "string",
                    "effectiveDate": "string",
                    "terminationDate": "string",
                    "insuranceType": "string",
                    "verbalLanguagePreference": "string",
                    "writtenLanguagePreference": "string",
                    "informationalMessage": "string"
                  },
                  "submittingProvider": {
                    "firstName": "string",
                    "middleName": "string",
                    "lastName": "string",
                    "providerOrganizationName": "string",
                    "taxIdNumber": "string",
                    "address1": "string",
                    "address2": "string",
                    "city": "string",
                    "state": "string",
                    "zip": "string",
                    "zipSuffix": "string",
                    "primaryPhone": "string",
                    "fax": "string",
                    "status": "string"
                  },
                  "admittingAttendingProvider": {
                    "name": "string",
                    "taxIdNumber": "string",
                    "address1": "string",
